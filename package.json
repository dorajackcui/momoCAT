{
  "name": "simple-cat-tool-monorepo",
  "version": "1.0.7",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run rebuild:electron && npm run dev --workspace=apps/desktop",
    "build": "npm run rebuild:electron && npm run build --workspace=apps/desktop",
    "pack": "npm run rebuild:electron && npm run pack --workspace=apps/desktop",
    "pack:win": "node scripts/pack-platform.mjs --platform=win",
    "release:win": "node scripts/pack-platform.mjs --platform=win -- --publish always",
    "pack:mac": "node scripts/pack-platform.mjs --platform=mac",
    "worktree:deps:link": "node scripts/worktree-link-deps.mjs",
    "worktree:deps:link:force": "node scripts/worktree-link-deps.mjs --force",
    "lint": "npm run lint --workspaces",
    "gate:arch": "node scripts/gate-architecture-check.mjs",
    "docs:check": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "test:scripts": "node --test scripts",
    "ai-prompts:generate": "node scripts/generate-ai-prompt-templates.mjs",
    "ai-prompts:check": "node scripts/generate-ai-prompt-templates.mjs --check",
    "gate:style": "node scripts/gate-style-classes.mjs",
    "gate:file-size": "node scripts/gate-file-size.mjs",
    "gate:smoke:large-file": "vitest run apps/desktop/src/main/services/modules/TMModule.test.ts -t \"scans segments page by page\"",
    "typecheck": "npm run typecheck --workspace=apps/desktop",
    "gate:check": "npm run docs:check && npm run test:scripts && npm run ai-prompts:check && npm run typecheck --workspace=apps/desktop && npm run gate:arch && npm run gate:style && npm run gate:file-size && npm run lint && npm run gate:smoke:large-file",
    "rebuild:electron": "node scripts/rebuild-electron.mjs",
    "rebuild:test": "npm rebuild better-sqlite3",
    "test": "npm run rebuild:test && vitest run",
    "test:db-schema": "npm run rebuild:test && vitest run packages/db/src/currentSchema.test.ts packages/db/src/index.test.ts",
    "test:tm-flow": "npm run rebuild:test && vitest run apps/desktop/src/main/services/TMMatchFlow.test.ts",
    "trace:tm-flow": "npm run rebuild:test && node scripts/tm-match-flow-trace.mjs",
    "trace:tb-flow": "npm run rebuild:test && node scripts/tb-match-flow-trace.mjs",
    "trace:ai-file": "npm run rebuild:test && node scripts/ai-file-flow-trace.mjs",
    "build:cli": "npm run build --workspace=packages/localization && npm run build --workspace=apps/cli",
    "cli": "node apps/cli/dist/index.mjs",
    "smoke:momocat": "npm run build:cli && node scripts/momocat-standard-smoke.mjs",
    "test:watch": "vitest",
    "postinstall": "npm run rebuild:electron",
    "format": "prettier --write ."
  },
  "volta": {
    "node": "20.19.0",
    "npm": "10.8.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "electron-rebuild": "^3.2.9",
    "prettier": "^3.8.1",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
