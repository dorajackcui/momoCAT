{
  "projectService": {
    "allowedDelegateFields": [
      "projectModule",
      "tmModule",
      "tbModule",
      "aiModule",
      "segmentService"
    ],
    "delegationExceptions": ["onProgress", "onSegmentsUpdated"]
  },
  "catDatabase": {
    "publicMethods": [
      "bulkInsertSegments",
      "close",
      "createFile",
      "createProject",
      "createTM",
      "createTermBase",
      "deleteFile",
      "deleteProject",
      "deleteTM",
      "deleteTermBase",
      "findTMEntryByHash",
      "findTMEntryMetaByHash",
      "getFile",
      "getProject",
      "getProjectIdByFileId",
      "getProjectTypeByFileId",
      "getProjectMountedTMs",
      "getProjectMountedTermBases",
      "getProjectSegmentsByHash",
      "getProjectStats",
      "getSegment",
      "getSegmentsPage",
      "getSetting",
      "getTM",
      "getTMStats",
      "getTermBase",
      "getTermBaseStats",
      "incrementTBUsage",
      "insertTBEntryIfAbsentBySrcTerm",
      "insertTMEntryIfAbsentBySrcHash",
      "insertTMFts",
      "listFiles",
      "listProjectTermEntries",
      "listProjects",
      "listTBEntries",
      "listTMs",
      "listTermBases",
      "mountTMToProject",
      "mountTermBaseToProject",
      "replaceTMFts",
      "runInTransaction",
      "searchProjectTermEntries",
      "searchConcordance",
      "searchTMConcordanceRecallCandidates",
      "searchTMFuzzyRecallCandidates",
      "searchTMRecallCandidates",
      "setSetting",
      "unmountTMFromProject",
      "unmountTermBaseFromProject",
      "updateFileStats",
      "updateProjectAISettings",
      "updateProjectQASettings",
      "updateProjectPrompt",
      "updateSegmentQaIssues",
      "updateSegmentTarget",
      "upsertTBEntryBySrcTerm",
      "upsertTMEntry",
      "upsertTMEntryBySrcHash"
    ],
    "legacyMultiRepoMethods": ["createProject", "listProjects"],
    "allowedDirectDbMethods": ["close"]
  },
  "catCore": {
    "rootBarrelModule": "@cat/core",
    "rootBarrelPath": "packages/core/src/index.ts",
    "checkedRoots": [
      "apps/desktop/src",
      "packages/db/src",
      "packages/core/src"
    ],
    "allowedRootBarrelImportFiles": ["packages/core/src/index.test.ts"],
    "allowedInternalRootIndexImportFiles": ["packages/core/src/index.test.ts"]
  },
  "forbiddenImports": [
    {
      "sourceRoot": "packages/localization/src",
      "forbiddenTargetRoot": "apps/desktop/src/main",
      "forbiddenSpecifierPatterns": [
        "^apps/desktop/src/main(?:/|$)",
        "^@desktop/main(?:/|$)"
      ],
      "message": "@cat/localization must not import desktop main code"
    },
    {
      "sourceRoot": "packages/localization/src",
      "forbiddenTargetRoot": "apps/desktop/src/shared",
      "forbiddenSpecifierPatterns": [
        "^apps/desktop/src/shared(?:/|$)",
        "^@desktop/shared(?:/|$)"
      ],
      "message": "@cat/localization must not import desktop shared IPC code"
    },
    {
      "sourceRoot": "apps/cli/src",
      "forbiddenTargetRoot": "apps/desktop/src",
      "forbiddenSpecifierPatterns": [
        "^apps/desktop/src(?:/|$)",
        "^@desktop(?:/|$)"
      ],
      "message": "apps/cli must not import desktop code"
    },
    {
      "sourceRoot": "apps/cli/src",
      "forbiddenTargetRoot": "packages/db/src",
      "forbiddenSpecifierPatterns": [
        "^@cat/db(?:/|$)",
        "^packages/db/src(?:/|$)"
      ],
      "message": "apps/cli must depend on @cat/localization, not @cat/db"
    },
    {
      "sourceRoot": "apps/cli/src",
      "forbiddenTargetRoot": "packages/core/src",
      "forbiddenSpecifierPatterns": [
        "^@cat/core(?:/|$)",
        "^packages/core/src(?:/|$)"
      ],
      "message": "apps/cli must depend on @cat/localization, not @cat/core"
    },
    {
      "sourceRoot": "apps/desktop/src",
      "forbiddenTargetRoot": "apps/cli/src",
      "forbiddenSpecifierPatterns": [
        "^apps/cli/src(?:/|$)",
        "^@cat/cli(?:/|$)"
      ],
      "message": "apps/desktop must not import CLI code"
    },
    {
      "sourceRoot": "packages/localization/src",
      "forbiddenTargetRoot": "apps/cli/src",
      "forbiddenSpecifierPatterns": [
        "^apps/cli/src(?:/|$)",
        "^@cat/cli(?:/|$)"
      ],
      "message": "@cat/localization must not import CLI code"
    }
  ]
}
