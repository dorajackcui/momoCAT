{
  "name": "@cat/localization",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && npm run build:bundle",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --external:better-sqlite3 --external:xlsx",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@cat/core": "*",
    "@cat/db": "*",
    "fastest-levenshtein": "^1.0.16",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.0.0"
  }
}
